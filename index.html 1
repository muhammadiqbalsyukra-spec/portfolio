    </div>

    <div class="badge">
      FMCG / F&B
    </div>

  </div>

</section>


<!-- WORK -->

<section id="work">

<div class="container">

  <div class="head">

    <div>

      <div class="kicker">
        Selected work
      </div>

      <h2>
