<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Iqbal Graphic Designer Portfolio | FMCG, F&B, Packaging, Social Media">
<meta name="author" content="Iqbal">

<title>Iqbal | Graphic Designer Portfolio</title>

<style>
:root{
  --bg:#f6f1e7;
  --paper:#fffdf8;
  --ink:#172235;
  --muted:#667085;
  --yellow:#f4c542;
  --green:#3d6b4f;
  --red:#c94b3c;
  --line:#e8e0d3;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:var(--bg);
  color:var(--ink);
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

/* NAVBAR */

nav{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:100;
  background:rgba(246,241,231,.88);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--line);
}

.nav{
  height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:23px;
  font-weight:900;
  letter-spacing:-1px;
}

.logo span{
  color:var(--red);
}

.links{
  display:flex;
  gap:28px;
  font-size:14px;
  font-weight:800;
}

.links a{
  transition:.2s;
}

.links a:hover{
  color:var(--red);
}

/* HERO */

.hero{
  min-height:100vh;
  padding:140px 0 70px;
  display:grid;
  grid-template-columns:1.1fr .9fr;
  align-items:center;
  gap:60px;
}

.eyebrow{
  display:inline-block;
  padding:8px 13px;
  border:1px solid var(--line);
  border-radius:99px;
  background:var(--paper);
  font-size:11px;
  font-weight:900;
  letter-spacing:.1em;
  text-transform:uppercase;
}

.eyebrow i{
  display:inline-block;
  width:8px;
  height:8px;
  background:var(--green);
  border-radius:50%;
  margin-right:7px;
}

h1{
  font-size:clamp(55px,8vw,95px);
  line-height:.9;
  letter-spacing:-.07em;
  margin:28px 0;
}

.hero h1 em{
  color:var(--red);
  font-style:normal;
}

.hero p{
  font-size:18px;
  color:var(--muted);
  max-width:620px;
}

.actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:28px;
}

.btn{
  display:inline-block;
  padding:13px 19px;
  border-radius:12px;
  border:1px solid var(--ink);
  font-size:14px;
  font-weight:900;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-3px);
}

.primary{
  background:var(--ink);
  color:#fff;
}

.secondary{
  background:var(--paper);
}

/* HERO ART */

.art{
  height:510px;
  position:relative;
}

.blob{
  position:absolute;
  width:350px;
  height:350px;
  right:0;
  top:50px;
  background:var(--yellow);
  border-radius:48% 52% 60% 40%;
  transform:rotate(-8deg);
}

.pack{
  position:absolute;
  width:285px;
  height:390px;
  right:75px;
  top:90px;
  background:var(--paper);
  border:1px solid #eee5d8;
  border-radius:22px;
  padding:22px;
  box-shadow:0 25px 60px #17223520;
  transform:rotate(7deg);
}

.brand{
  height:65px;
  border-radius:14px;
  background:var(--green);
  display:grid;
  place-items:center;
  color:#fff;
  font-weight:900;
  letter-spacing:.08em;
}

.pack h2{
  font-size:28px;
  line-height:.9;
  margin:45px 0 12px;
}

.banana{
  width:150px;
  height:115px;
  border-radius:50%;
  background:var(--red);
  margin:18px auto;
  position:relative;
}

.banana:after{
  content:"";
  position:absolute;
  inset:17px;
  border-radius:50%;
  background:var(--yellow);
}

.badge{
  position:absolute;
  left:-35px;
  bottom:45px;
  background:var(--ink);
  color:#fff;
  padding:14px 18px;
  border-radius:13px;
  font-weight:900;
  transform:rotate(-10deg);
}

/* GENERAL SECTIONS */

section{
  padding:105px 0;
}

.head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:30px;
  margin-bottom:35px;
}

.kicker{
  color:var(--red);
  font-size:11px;
  font-weight:900;
  letter-spacing:.15em;
  text-transform:uppercase;
}

.head h2{
  font-size:clamp(40px,5vw,62px);
  line-height:.95;
  letter-spacing:-.06em;
  margin:8px 0;
}

.head p{
  max-width:420px;
  color:var(--muted);
}

/* PROJECT GRID */

.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:22px;
}

.project{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 10px 30px #1722350d;
  transition:.25s;
}

.project:hover{
  transform:translateY(-7px);
  box-shadow:0 25px 60px #17223518;
}

.visual{
  height:350px;
  display:grid;
  place-items:center;
  padding:25px;
}

.yellow{
  background:var(--yellow);
}

.cream{
  background:#eee5d7;
}

.green{
  background:var(--green);
}

.dark{
  background:var(--ink);
}

/* PACKAGING */

.mockpack{
  width:205px;
  height:280px;
  background:var(--yellow);
  border-radius:18px;
  box-shadow:0 25px 35px #0003;
  overflow:hidden;
  transform:rotate(-4deg);
}

.mockpack .top{
  height:55px;
  background:var(--green);
  display:grid;
  place-items:center;
  color:#fff;
  font-weight:900;
}

.mockpack h3{
  text-align:center;
  font-size:27px;
  line-height:.9;
  margin:45px 0 12px;
}

.fruit{
  width:115px;
  height:90px;
  border-radius:50%;
  background:var(--red);
  margin:auto;
  position:relative;
}

.fruit:after{
  content:"";
  position:absolute;
  inset:14px;
  border-radius:50%;
  background:var(--yellow);
}

/* PROMO */

.promo{
  width:88%;
  padding:35px;
  background:#fff;
  border-radius:18px;
  box-shadow:0 25px 45px #0002;
  transform:rotate(2deg);
}

.promo .bar{
  background:var(--red);
  color:#fff;
  padding:14px;
  border-radius:10px;
  text-align:center;
  font-weight:900;
}

.promo .buy{
  font-size:58px;
  font-weight:950;
  line-height:.9;
  margin-top:25px;
}

.promo .get{
  font-size:45px;
  font-weight:950;
  color:var(--green);
}

/* SOCIAL */

.social{
  width:245px;
  height:295px;
  background:#f7f2e8;
  border:14px solid var(--ink);
  border-radius:28px;
  padding:24px;
  box-shadow:0 25px 45px #0003;
}

.social small{
  font-weight:900;
  color:var(--green);
}

.social h3{
  font-size:27px;
  line-height:.9;
  margin-top:25px;
}

.plate{
  width:125px;
  height:95px;
  background:var(--yellow);
  border-radius:50%;
  margin:25px auto;
}

/* FLYER */

.flyer{
  width:82%;
  background:#fff;
  padding:28px;
  border-radius:12px;
  box-shadow:0 25px 45px #0003;
}

.flyer .title{
  background:var(--green);
  color:#fff;
  padding:22px;
  border-radius:9px;
  font-size:23px;
  font-weight:900;
}

.rows{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
  margin-top:22px;
}

.rows i{
  height:70px;
  background:#eee5d7;
  border-radius:8px;
}

/* PROJECT INFO */

.info{
  padding:23px;
}

.tag{
  font-size:10px;
  color:var(--red);
  font-weight:900;
  letter-spacing:.12em;
  text-transform:uppercase;
}

.info h3{
  font-size:23px;
  margin:7px 0;
}

.info p{
  font-size:14px;
  color:var(--muted);
  margin:0;
}

/* ABOUT */

.about{
  background:var(--ink);
  color:#fff;
}

.about .kicker{
  color:var(--yellow);
}

.about .head p{
  color:#cbd2dd;
}

.aboutgrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:70px;
}

.copy{
  font-size:20px;
  color:#d8dee8;
}

.skills{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.skill{
  padding:18px;
  border:1px solid #344156;
  border-radius:15px;
  background:#1d2a3e;
  font-weight:800;
}

/* PROCESS */

.steps{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
}

.step{
  background:var(--paper);
  border:1px solid var(--line);
  padding:22px;
  border-radius:17px;
}

.step b{
  color:var(--red);
  font-size:11px;
}

.step h3{
  margin:25px 0 7px;
}

.step p{
  font-size:13px;
  color:var(--muted);
}

/* CONTACT */

.contact{
  background:var(--yellow);
}

.contactbox{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.contact .btn{
  background:var(--ink);
  color:#fff;
  border-color:var(--ink);
}

/* FOOTER */

footer{
  background:var(--ink);
  color:#aeb7c4;
  padding:25px 0;
  font-size:13px;
}

.foot{
  display:flex;
  justify-content:space-between;
}

/* MOBILE */

@media(max-width:800px){

  .links{
    display:none;
  }

  .hero{
    grid-template-columns:1fr;
  }

  .art{
    height:410px;
  }

  .pack{
    right:8%;
  }

  .grid,
  .aboutgrid{
    grid-template-columns:1fr;
  }

  .steps{
    grid-template-columns:1fr 1fr;
  }

  .head,
  .contactbox{
    display:block;
  }

  .head p{
    margin-top:15px;
  }

  .contact .actions{
    margin-top:20px;
  }
}

@media(max-width:480px){

  h1{
    font-size:57px;
  }

  .art{
    height:340px;
  }

  .blob{
    width:280px;
    height:280px;
  }

  .pack{
    width:230px;
    height:315px;
    right:7%;
    top:45px;
  }

  .visual{
    height:300px;
  }

  .steps{
    grid-template-columns:1fr;
  }

  .foot{
    display:block;
  }

  .foot span{
    display:block;
    margin-top:7px;
  }
}
</style>
</head>

<body>

<nav>
  <div class="container nav">
    <a class="logo" href="#top">IQBAL<span>.</span></a>

